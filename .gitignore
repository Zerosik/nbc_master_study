# Visual Studio / IDE user state
.vs/
.vscode/
.idea/
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.user
*.userosscache
*.sln.docstates
.vsconfig

# Generated project files
*.sln
*.xcodeproj
*.xcworkspace

# Unreal Engine generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Plugin generated folders
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/
Plugins/**/DerivedDataCache/

# Compiled object / library / executable files
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.ipch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.exp
*.pdb
*.ilk

# Unreal generated metadata
*.target
*.modules
*.version

# Built data can be regenerated by Unreal
*_BuiltData.uasset

# Source art intermediates commonly regenerated outside Content
SourceArt/**/*.png
SourceArt/**/*.tga

# Build exceptions sometimes used by packaged projects
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# OS files
.DS_Store
Thumbs.db

# Logs and crash dumps
*.log
*.dmp
